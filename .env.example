# Copy to .env before running anything: cp .env.example .env
#
# Every variable the system reads is listed here, and every one of them works as
# it stands - the values below are a running configuration, not placeholders. The
# single exception is ANTHROPIC_API_KEY, which is empty because a key does not
# belong in a committed file. Fill it in before starting the worker; everything
# else (migrations, the seed, the API, the whole test suite) runs without it.
#
# The `(phase N)` labels below mark which build phase introduced each group and
# correspond to section 10 of docs/PHASE-0-PLAN.md. They are provenance, not
# ordering: all of these are read today.

# development | test | production
NODE_ENV=development

# --- docker-compose (read by docker-compose.yml, not by the app) -------------
POSTGRES_USER=cvscreening
POSTGRES_PASSWORD=cvscreening
POSTGRES_DB=cv_screening
# Host ports. Defaults avoid 5432/6379, which are usually already taken.
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389

# --- application -------------------------------------------------------------
# Must match the compose credentials and POSTGRES_HOST_PORT above.
DATABASE_URL=postgres://cvscreening:cvscreening@localhost:5442/cv_screening

# Separate database, same server. Tests truncate every table between cases, so
# pointing this at DATABASE_URL would destroy dev data; env.js rejects that.
TEST_DATABASE_URL=postgres://cvscreening:cvscreening@localhost:5442/cv_screening_test

# Upper bound on pooled connections held by one process.
DB_POOL_MAX=10

# --- Anthropic (phase 2b) ----------------------------------------------------
# The screening worker refuses to start without this. It is deliberately NOT
# required by config/env.js: migrations, the seed and the unit suite all run
# without a key, and none of them spends a token. Leave it empty here - an empty
# value is treated exactly like an absent one - and put the real key in .env,
# which is gitignored.
ANTHROPIC_API_KEY=

# --- HTTP server (phase 4) ---------------------------------------------------
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Uploads (phase 4) -------------------------------------------------------
# Where CV files are written. candidates.storage_path is stored relative to this,
# so the root can move without a data migration. The API and the worker must
# share this filesystem (plan section 8).
UPLOAD_ROOT=./uploads
# Per-file ceiling in bytes. 5 MiB.
MAX_UPLOAD_BYTES=5242880
# Files accepted in one batch upload.
MAX_BATCH_FILES=50

# --- Queue and worker (phase 4) ----------------------------------------------
# Must match REDIS_HOST_PORT above.
REDIS_URL=redis://localhost:6389
# THE CONCURRENCY DIAL. Candidates screened at once by one worker process, and
# therefore the bound on in-flight Anthropic calls for the whole system. A 50-CV
# batch becomes 50 queued jobs and this many API calls. Turn it down to 1 during
# an incident; no deploy needed.
SCREENING_CONCURRENCY=4
# Queue-side attempts per candidate, and the exponential backoff base between
# them. Separate from the agent layer's single semantic retry inside one attempt.
SCREENING_JOB_ATTEMPTS=3
SCREENING_JOB_BACKOFF_MS=10000
# How long the worker blocks on an empty queue, seconds - BullMQ's `drainDelay`.
# A tuning knob locally and a COST CONTROL on a metered Redis. Measured against
# bullmq@6.1.2 with a real Redis: at this default an idle worker issues ~100
# commands a minute (~6,400 an awake hour), because each idle cycle is a
# bzpopmin, an evalsha, the six inner commands Redis counts for that script, and
# a keepalive ping. Against Upstash's free tier of 500,000 a month that is about
# 79 awake hours. Raising it to 30 cuts that to ~1,600 an hour and costs nothing
# in latency - a job added while the worker is blocked wakes it immediately.
# Both claims are asserted in server/test/queue/idleCost.test.js.
SCREENING_DRAIN_DELAY_S=5

# --- Rate limiting (phase 4) -------------------------------------------------
# Applied to the two upload endpoints only - they are the ones that spend money.
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# --- CORS (phase 5) ----------------------------------------------------------
# Comma-separated allowlist of browser origins allowed to call this API. Each
# entry must be a bare origin: scheme, host and optional port, no path and no
# trailing slash. Startup fails by name on anything else - including `*`.
#
# The default below is the Vite dev server (web/vite.config.js pins port 5173).
# It is deliberately NOT `*`: a wildcard would mean this variable never has to be
# set and never fails, so a deployment serving the UI from another origin would
# only find out when someone reported that nothing loads. With a dev-origin
# default, that deployment fails immediately and the fix is one variable.
#
# In development the Vite proxy means the browser makes same-origin requests and
# this is not exercised at all; it is here for every deployment that is not that.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Reconciliation (phase 4) ------------------------------------------------
# How long a candidate may sit in a non-terminal status before
# scripts/reconcileStuck.js treats it as stranded. Must exceed the agent layer's
# 240s per-candidate deadline plus queue backoff. 15 minutes.
STUCK_CANDIDATE_AGE_MS=900000

# --- Storage backend (phase 6) -----------------------------------------------
# local | s3
#
# `local` writes CVs under UPLOAD_ROOT and is the development default; nothing
# about it changed. `s3` is for any deployment where the API and the worker do
# not share a filesystem - which is every deployment that runs them as two
# processes, and also every host that resets the disk on restart.
#
# candidates.storage_path holds the same relative string under both, so
# switching drivers needs no data migration. It does need the files: a candidate
# uploaded under `local` has no object in the bucket, and its retry will answer
# SOURCE_FILE_MISSING.
STORAGE_DRIVER=local

# Required only when STORAGE_DRIVER=s3; startup fails by name if one is missing.
# Backblaze B2 (free, no card): endpoint is https://s3.<region>.backblazeb2.com
# and the region is the one in that hostname, e.g. us-west-004.
# Cloudflare R2 also works: https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path style addresses the bucket as <endpoint>/<bucket>/<key>. True works on B2
# and R2; set false for AWS S3 proper, which has deprecated it.
S3_FORCE_PATH_STYLE=true

# --- Co-located worker (phase 6) ---------------------------------------------
# Runs the screening worker INSIDE the API process.
#
# false is the honest default: src/worker.js is the worker's entry point, it is
# what `npm run worker` starts, and it is what a two-process deployment runs.
# This exists because free hosting tiers offer one always-on process, and one
# process that screens is worth more than two that do not exist.
#
# It is a deployment toggle, not a second implementation - server.js calls the
# same startScreeningWorker() worker.js does. What it costs is fault isolation:
# a crash in PDF parsing takes the HTTP API down with it.
RUN_WORKER_IN_PROCESS=false

# --- Spend guard (phase 6) ---------------------------------------------------
# A shared secret required by the two upload endpoints AND by the retry endpoint
# (a retry re-runs both model calls, so it costs what an upload costs).
#
# EMPTY MEANS OFF, which is what keeps local development and the test suite
# untouched. When set, the browser client must send the same value as
# VITE_UPLOAD_TOKEN - and because VITE_ variables are compiled into the bundle,
# that value is visible to anyone who opens devtools. This is a speed bump
# against a crawler finding a public URL and spending the API budget. It is NOT
# authentication, it establishes no principal, and the README says so.
UPLOAD_ACCESS_TOKEN=

# --- Health check (phase 6) --------------------------------------------------
# How long GET /health waits for Postgres or Redis before reporting it
# unreachable, milliseconds.
#
# There has to be a bound. The Redis connection uses enableOfflineQueue, so a
# command issued while disconnected is buffered rather than rejected and the
# ping never settles - without this, /health hangs instead of answering 503, and
# a health check that hangs is one no load balancer can act on.
DEPENDENCY_CHECK_TIMEOUT_MS=2000
