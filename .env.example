# Copy to .env before running anything: cp .env.example .env
# Phase 1 needs database connectivity only. Redis, Anthropic and upload settings
# arrive in later phases; they are deliberately absent so the startup schema fails
# on anything it does not actually use.

# development | test | production
NODE_ENV=development

# --- docker-compose (read by docker-compose.yml, not by the app) -------------
POSTGRES_USER=cvscreening
POSTGRES_PASSWORD=cvscreening
POSTGRES_DB=cv_screening
# Host ports. Defaults avoid 5432/6379, which are usually already taken.
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389

# --- application -------------------------------------------------------------
# Must match the compose credentials and POSTGRES_HOST_PORT above.
DATABASE_URL=postgres://cvscreening:cvscreening@localhost:5442/cv_screening

# Separate database, same server. Tests truncate every table between cases, so
# pointing this at DATABASE_URL would destroy dev data; env.js rejects that.
TEST_DATABASE_URL=postgres://cvscreening:cvscreening@localhost:5442/cv_screening_test

# Upper bound on pooled connections held by one process.
DB_POOL_MAX=10

# --- Anthropic (phase 2b) ----------------------------------------------------
# The screening worker refuses to start without this. It is deliberately NOT
# required by config/env.js: migrations, the seed and the unit suite all run
# without a key, and none of them spends a token. Leave it empty here - an empty
# value is treated exactly like an absent one - and put the real key in .env,
# which is gitignored.
ANTHROPIC_API_KEY=

# --- HTTP server (phase 4) ---------------------------------------------------
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Uploads (phase 4) -------------------------------------------------------
# Where CV files are written. candidates.storage_path is stored relative to this,
# so the root can move without a data migration. The API and the worker must
# share this filesystem (plan section 8).
UPLOAD_ROOT=./uploads
# Per-file ceiling in bytes. 5 MiB.
MAX_UPLOAD_BYTES=5242880
# Files accepted in one batch upload.
MAX_BATCH_FILES=50

# --- Queue and worker (phase 4) ----------------------------------------------
# Must match REDIS_HOST_PORT above.
REDIS_URL=redis://localhost:6389
# THE CONCURRENCY DIAL. Candidates screened at once by one worker process, and
# therefore the bound on in-flight Anthropic calls for the whole system. A 50-CV
# batch becomes 50 queued jobs and this many API calls. Turn it down to 1 during
# an incident; no deploy needed.
SCREENING_CONCURRENCY=4
# Queue-side attempts per candidate, and the exponential backoff base between
# them. Separate from the agent layer's single semantic retry inside one attempt.
SCREENING_JOB_ATTEMPTS=3
SCREENING_JOB_BACKOFF_MS=10000

# --- Rate limiting (phase 4) -------------------------------------------------
# Applied to the two upload endpoints only - they are the ones that spend money.
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# --- Reconciliation (phase 4) ------------------------------------------------
# How long a candidate may sit in a non-terminal status before
# scripts/reconcileStuck.js treats it as stranded. Must exceed the agent layer's
# 240s per-candidate deadline plus queue backoff. 15 minutes.
STUCK_CANDIDATE_AGE_MS=900000
