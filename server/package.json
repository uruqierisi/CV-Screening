{
  "name": "cv-screening-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "AI CV Screening & Applicant Ranking System - server. Phases 1, 2a, 2b and 3: data layer, deterministic core, model-facing layer, document parsing.",
  "scripts": {
    "migrate": "node --env-file-if-exists=../.env src/scripts/migrate.js up",
    "migrate:down": "node --env-file-if-exists=../.env src/scripts/migrate.js down",
    "migrate:redo": "node --env-file-if-exists=../.env src/scripts/migrate.js redo",
    "seed": "node --env-file-if-exists=../.env src/scripts/seed.js",
    "fixtures:documents": "node test/extraction/fixtures/generate.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:db": "vitest run --project db",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "pg": "^8.13.1",
    "unpdf": "^1.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "node-pg-migrate": "^9.0.0",
    "vitest": "^4.1.11"
  }
}
